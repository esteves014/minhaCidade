        android:fillColor="#40000000"
        android:pathData="M45,88.5a9,2.2 0 1,0 18,0a9,2.2 0 1,0 -18,0" />

    <!-- Alfinete (gota) com leve degradê -->
    <path android:pathData="M54,88 C46,78 30,62 30,46 A24,24 0 0 1 78,46 C78,62 62,78 54,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="88">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD9E6F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sol -->
