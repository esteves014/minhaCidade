<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo do minhaCidade: alfinete de localização (denúncias com mapa) contendo o
    horizonte da cidade (vagas, notícias) sob um sol (cidade que amanhece).
    Conteúdo dentro da zona segura (66dp centrais dos 108dp).
-->
